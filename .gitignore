# Local environment and secrets
.env
.env.*
!.env.example
.venv/
venv/

# Python caches and generated files
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE/editor state
.idea/
.vscode/
*.swp
*.swo

# Frontend dependencies and build outputs
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Local source corpora, processed artifacts, and vector indexes
data/
frontend/.cache/
!data/
data/*
!data/chronology_registry/
!data/chronology_registry/v1/
!data/chronology_registry/v1/records.jsonl
!data/chronology_registry/v1/source_manifest.json
!data/historical_sources/
data/historical_sources/*
!data/historical_sources/raw/
data/historical_sources/raw/*
!data/historical_sources/raw/caesar/
data/historical_sources/raw/caesar/*
!data/historical_sources/raw/caesar/corpus.json

# Official Itiner-e raw exports are reproducible local data, not source assets.
!data/raw/
!data/raw/itiner_e/
data/raw/itiner_e/*.ndjson
data/raw/itiner_e/*.geojson
data/raw/itiner_e/topology_benchmark.json

# General local logs
*.log

# Local evaluation and diagnostic outputs
outputs/
scripts/_v1*.py
scripts/_geo.json
scripts/g6bk_*.py
scripts/g6bn_*.py
